{
  "openapi": "3.1.0",
  "info": {
    "title": "Python SDK multipart",
    "version": "1.0.0"
  },
  "paths": {
    "/images": {
      "post": {
        "operationId": "upload_image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Uploaded"
          }
        }
      }
    }
  }
}
